# Local development defaults. Copy to .env and replace the password before
# using this configuration outside a local development environment.
#
# COMPOSE_PROJECT_NAME is deliberately left unset here: `bastion` derives a
# name unique to this checkout's absolute path so a second clone never
# recreates this one's containers. Set it explicitly only if you want a
# stable, predictable project name for this specific checkout (e.g. in
# scripts); make sure it doesn't collide with another clone's.
# COMPOSE_PROJECT_NAME=
POSTGRES_DB=bastion
POSTGRES_USER=bastion
POSTGRES_PASSWORD=bastion_dev_password_change_me
POSTGRES_PORT=5432

VALKEY_PORT=6380
# Used only with `docker compose --profile local-inference up`; the default
# inference backend is host-native Ollama.
OLLAMA_PORT=11434

# Bastion.Gate local runtime defaults
DATABASE_URL=postgresql+asyncpg://bastion:bastion_dev_password_change_me@localhost:5432/bastion
# Gate/Strike inference URL when they run natively on the host.
OLLAMA_BASE_URL=http://localhost:11434
# Compose-only inference URL. The default reaches host-native Ollama. To use
# containerized inference, set COMPOSE_OLLAMA_BASE_URL=http://ollama:11434
# and run `docker compose --profile local-inference up`; both are required.
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Leave unset for the production-equivalent default. demo-permissive is only
# for the local detect-propose-harden demonstration and must never protect traffic.
GATE_POLICY_PROFILE=
GATE_PORT=8000
OLLAMA_TIMEOUT_SECONDS=120
# Value-anchored Gate marker detection. Set exactly one local override below,
# or mount a JSON object of {"marker_ref": "secret-value"} and set
# GATE_MARKER_SECRETS_FILE to its in-container path. Do not put marker values
# in policy YAML, logs, or exported records. The environment value overrides
# the mounted file for local development.
GATE_MARKER_SECRETS_FILE=
# Public synthetic value for the deliberately vulnerable demo target only;
# MUST be changed before Gate proxies real traffic.
GATE_MARKER_SAMPLE_BANK_INTERNAL_CONFIGURATION_MARKER=BASTION-CANARY-7K2M9QX4

# Hugging Face read-scoped token with access to the gated Llama Prompt Guard 2 model.
HF_TOKEN=

# SampleBank Copilot local runtime defaults
GATE_BASE_URL=http://localhost:8000
SAMPLE_TARGET_PORT=8080
SAMPLE_TARGET_MODEL=llama3.1:8b

# Bastion.Strike local runtime defaults. DATABASE_URL above is shared with Gate.
STRIKE_REQUEST_TIMEOUT_SECONDS=60
# Timeout for each Ollama planner or PruneGate request. A reviewed campaign
# YAML may override this with planner_request_timeout_seconds.
STRIKE_PLANNER_REQUEST_TIMEOUT_SECONDS=45
VALKEY_URL=redis://localhost:6380/0
EMBEDDING_MODEL=nomic-embed-text

# Bastion.Control local runtime default
CONTROL_PORT=5080
